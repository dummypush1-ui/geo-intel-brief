# Copyright (c) 2026 Push. Example values only, never real credentials.
# Set values in Render environment. Do not commit .env or filled-in copies.
# This is code backup/staging, not deployment instructions.
# Start ONLY integration.private_router:app for staging, never legacy launchers.
# Collection, delivery and scraper remain OFF. Login/live storage still unwired.
# NEWS_READ_ENABLED alone does not create a client or enable public access.
# Project-specific storage overrides apply to the new settings adapter.
# Legacy engines still use their original unprefixed names; do not launch together
# until config isolation and single-owner cutover are reviewed.

# Private workspace settings
# Owner confirmed BRICS uses MongoDB. SQLite remains optional only.
GEO_MONGODB_DB_NAME=geo_intel
GEO_ARTICLES_COLLECTION=articles
GEO_EVENTS_COLLECTION=events
BRICS_MONGODB_DB=newsbot
BRICS_ARTICLES_COLLECTION=articles
BRICS_SQLITE_PATH=data/newsbot.db
