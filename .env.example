# New merged delivery: Apps Script only. No SMTP fallback in the merged route.
# OFF until reviewed cutover. These settings do not wire or activate a sender.
MERGED_MAIL_PATH=apps_script
MERGED_MAIL_ENABLED=false

# Verified merged HTTPS origin for social metadata; leave blank until deployed.
# Does not unlock private assets for crawlers.
MERGED_PUBLIC_BASE_URL=

# Single-worker private preview only, not production account login.
PREVIEW_ACCESS_ENABLED=false
# Explicit HTTPS origin; deployment is a separate approval.
PREVIEW_ORIGIN=
# Configure a scrypt/pbkdf2 hash and >=48-character random key securely.
PREVIEW_PASSWORD_HASH=
PREVIEW_SESSION_KEY=
# Set true only after actual project-store ownership/schema review.
NEWS_STORE_MAPPING_VERIFIED=false
# Keep false unless deployment confirms exactly one trusted TLS proxy.
PREVIEW_TRUST_ONE_PROXY=false
# Use dedicated read-only Mongo users. A URI alone cannot prove permissions.
# Single-worker preview command: gunicorn --workers 1 integration.private_router:app
# Generate session key with secrets.token_urlsafe(48). Quote password hashes in .env.
# Logout clears this browser only; rotating the key revokes captured cookies.
# Preview password must be a >=16-character random passphrase, not a reused password.
# After 10 failures/5min, sign-in pauses globally (including correct passwords).
# Restrict preview URL distribution; use external rate limits before public use.
