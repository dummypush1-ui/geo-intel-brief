########################################################################
# GEO INTEL BRIEF - one .env for the whole service. Copy to .env.
# Anything prefixed BRICS_ or GEO_ overrides the shared name for that app only
# (e.g. BRICS_SMTP_PORT=587 and GEO_SMTP_PORT=465 below).
########################################################################

# ---- REQUIRED ----
# Guards every trigger / admin route. Unset or "changeme" = those routes refuse (fail closed).
TRIGGER_SECRET=
# Local dev only: set true to allow trigger routes without a secret.
ALLOW_INSECURE_LOCAL=false

# ---- Which apps to mount (all true by default) ----
ENABLE_HSN_APP=true
ENABLE_BRICS_APP=true
ENABLE_GEO_APP=true
# Public base URL of this service (used in digest / Telegram links), e.g. https://geo-intel-brief.onrender.com
PUBLIC_URL=

# ---- Scheduling ----
# true  = in-process scheduler (VM / Docker / paid always-on). Keep gunicorn at 1 worker.
# false = drive it from outside: POST /api/trigger/collect?key=TRIGGER_SECRET from cron-job.org
RUN_SCHEDULER=false
DATA_DIR=data

# ---- Storage ----
MONGODB_URI=                 # needed by Geo News; also by BRICS if STORAGE_BACKEND=mongodb
MONGODB_DB_NAME=geo_intel    # Geo News database
MONGODB_DB=newsbot           # BRICS database
STORAGE_BACKEND=sqlite       # BRICS: sqlite | mongodb   (use mongodb in the cloud)
DEPLOY_MODE=local            # BRICS: local | cloud

# ---- Email (shared credentials) ----
EMAIL_FROM=
EMAIL_TO=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
BRICS_SMTP_PORT=587
GEO_SMTP_PORT=465
ENABLE_EMAIL=false           # BRICS digest on/off (Geo News emails whenever credentials are set)

# ---- Telegram / WhatsApp ----
ENABLE_TELEGRAM=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ENABLE_WHATSAPP=false
WHATSAPP_PHONE=
WHATSAPP_APIKEY=
GEO_ENABLE_TELEGRAM_BACKUP=false   # default in Geo News is true; turn on only with the two vars below
TELEGRAM_BACKUP_CHAT_ID=
TELEGRAM_BACKUP_BOT_TOKEN=

# ---- BRICS ----
COLLECT_INTERVAL_TIER1_MINUTES=10
COLLECT_INTERVAL_TIER2_MINUTES=30
DIGEST_TIMES=09:00,20:00
DASHBOARD_KEY=               # optional; falls back to TRIGGER_SECRET for adding/removing live streams
ENABLE_CRITICAL_ALERTS=true
BRICS_DEDUPE_THRESHOLD=0.8

# ---- Geo News ----
DAILY_RUN_TIME=07:00
ENABLE_WEEKLY_REPORT=false
WEEKLY_REPORT_DAY=monday
ENABLE_GNEWS=false           # needs: pip install -r requirements-optional.txt
GEO_DEDUPE_THRESHOLD=0.85
ACTIVE_CATEGORIES=GEOPOLITICS,CONFERENCE,TRADE,SANCTIONS,RISK,RESEARCH,GENERAL

# ---- HSN finder: AI + live ships (server-side keys, comma-separated pools) ----
GROQ_KEYS=
GEMINI_KEYS=
MISTRAL_KEYS=
NVIDIA_KEYS=
AISSTREAM_KEY=
# Optional: let another origin (e.g. a self-hosted copy) call /hsn/api/*
HSN_ALLOWED_ORIGINS=
APP_SECRET=

# ---- Unified workspace (optional overrides) ----
# Sign in on / using TRIGGER_SECRET. API keys above work in workspace and HSN.
# SESSION_SECRET can separately sign sessions; otherwise TRIGGER_SECRET is used.
# SESSION_SECRET=
# BRICS_DASHBOARD_KEY=  # optional standalone stream key; workspace sign-in also works
# Provider model overrides (must be supported by your provider account):
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# MISTRAL_MODEL=mistral-small-latest
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# Free Render: RUN_SCHEDULER=false and use geonews/apps_script/Code.gs for both feeds.
