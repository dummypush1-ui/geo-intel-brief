# Candidate image target chosen by runtime and reviewer for build-input closure.
# Candidate inputs, build not run. INCOMPLETE until own CP312 sgml output anchor.
FROM ubuntu@sha256:f610ab94648195aa356059f5b41d6085c9d4d903c072430cdd1af7bdb646106b
ARG REVIEWED_APT_SOURCES_SHA256
ARG GCC_VERSION
ARG LIBC6_DEV_VERSION
ARG BWRAP_VERSION
COPY inputs /reviewed-inputs
COPY network-launcher.c /reviewed/network-launcher.c
# Missing workflow-ready lock deliberately refuses this incomplete package.
RUN test -f /reviewed-inputs/application.lock
RUN test "$GCC_VERSION" = '4:13.2.0-7ubuntu1' && test "$LIBC6_DEV_VERSION" = '2.39-0ubuntu8.9' && test "$BWRAP_VERSION" = '0.9.0-1ubuntu0.3' && echo "$REVIEWED_APT_SOURCES_SHA256  /reviewed-inputs/apt.sources" | sha256sum -c -
RUN rm -f /etc/apt/sources.list && rm -rf /etc/apt/sources.list.d/* && cp /reviewed-inputs/apt.sources /etc/apt/sources.list.d/runtime27b.sources && cp /reviewed-inputs/ubuntu-archive-keyring.gpg /usr/share/keyrings/runtime27b-ubuntu.gpg && echo '1a4dd63e5c76728960a2edddae22e2e0fc53df8e8b87806deb971030ac704eb0  /usr/share/keyrings/runtime27b-ubuntu.gpg' | sha256sum -c -
# ONE binary-deb exception, hash-reviewed CA bootstrap; extraction executes NO postinst.
RUN echo '6bac2a01979e210d9eac1d4d56747ec709ea60654744d66705dc3c36e7629e50  /reviewed-inputs/ca-certificates-bootstrap.deb' | sha256sum -c - && dpkg-deb -x /reviewed-inputs/ca-certificates-bootstrap.deb /bootstrap-ca && LC_ALL=C find /bootstrap-ca/usr/share/ca-certificates/mozilla -type f -name '*.crt' | LC_ALL=C sort > /tmp/bootstrap-ca-list && test "$(wc -l < /tmp/bootstrap-ca-list)" -eq 121 && while IFS= read -r p; do cat "$p"; done < /tmp/bootstrap-ca-list > /reviewed-inputs/bootstrap-ca.pem && echo '9481fcd95f41b221f02f14d896535fe500bec539bc563c4cdca1acee483a8bdd  /reviewed-inputs/bootstrap-ca.pem' | sha256sum -c - && printf 'Acquire::https::CaInfo "/reviewed-inputs/bootstrap-ca.pem";\n' > /etc/apt/apt.conf.d/99runtime27b-ca
# Existing Ubuntu apt/dpkg/shell bootstrap from digest-pinned base; no Python required until pinned apt install.
RUN /bin/sh /reviewed-inputs/apt_verify.sh
RUN python3.12 /reviewed-inputs/fetch_verify.py /reviewed-wheels
RUN python3.12 -m venv /opt/runtime27b && /opt/runtime27b/bin/python -I -m pip install --no-index --no-cache-dir --only-binary=:all: --find-links=/reviewed-wheels --require-hashes -r /reviewed-inputs/bootstrap.lock && /opt/runtime27b/bin/python -I -c "import importlib.metadata as m; assert m.version('pip')=='26.2.1' and m.version('setuptools')=='84.0.0'"
RUN /opt/runtime27b/bin/python -I -m pip install --no-index --no-cache-dir --only-binary=:all: --find-links=/reviewed-wheels --require-hashes -r /reviewed-inputs/application.lock && /opt/runtime27b/bin/python -I -m pip check
RUN gcc -Wall -Wextra -Werror -O2 /reviewed/network-launcher.c -o /usr/local/bin/network-launcher && mkdir /empty && chown 65534:65534 /empty
USER 65534:65534
WORKDIR /empty
# No server, provider, collector, client or app entrypoint. Network denied if launched.
ENTRYPOINT ["/usr/local/bin/network-launcher","/opt/runtime27b/bin/python","-I"]
CMD ["-c","raise SystemExit('candidate only: runtime acceptance not performed')"]
